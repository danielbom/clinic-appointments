{
  "/api/customers": {
    "get": {
      "operationId": "customers.listCustomers",
      "summary": "Get all customers",
      "tags": ["Customers"],
      "security": [{ "BearerAuth": [] }],
      "parameters": [
        { "$ref": "#/components/query/Page" },
        { "$ref": "#/components/query/PageSize" },
        { "$ref": "#/components/query/Name" },
        { "$ref": "#/components/query/Cpf" },
        { "$ref": "#/components/query/Phone" }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/Customer" }
              }
            }
          }
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/errors/ValidationProblemDetails"
              }
            }
          }
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/errors/AuthProblemDetails"
              }
            }
          }
        }
      }
    },
    "post": {
      "operationId": "customers.createCustomer",
      "summary": "Create a customer",
      "tags": ["Customers"],
      "security": [{ "BearerAuth": [] }],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/body/CustomerCreateBody"
            }
          }
        }
      },
      "responses": {
        "201": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Id"
              }
            }
          }
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/errors/ValidationProblemDetails"
              }
            }
          }
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/errors/AuthProblemDetails"
              }
            }
          }
        },
        "409": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/errors/ConflictProblemDetails"
              }
            }
          }
        }
      }
    }
  },
  "/api/customers/count": {
    "get": {
      "operationId": "customers.countCustomers",
      "summary": "Count customers",
      "tags": ["Customers"],
      "security": [{ "BearerAuth": [] }],
      "parameters": [
        { "$ref": "#/components/query/Name" },
        { "$ref": "#/components/query/Cpf" },
        { "$ref": "#/components/query/Phone" }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Count"
              }
            }
          }
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/errors/ValidationProblemDetails"
              }
            }
          }
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/errors/AuthProblemDetails"
              }
            }
          }
        }
      }
    }
  },
  "/api/customers/{id}": {
    "get": {
      "operationId": "customers.getCustomerById",
      "summary": "Get customer by id",
      "tags": ["Customers"],
      "security": [{ "BearerAuth": [] }],
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Customer"
              }
            }
          }
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/errors/ValidationProblemDetails"
              }
            }
          }
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/errors/AuthProblemDetails"
              }
            }
          }
        },
        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/errors/ValidationProblemDetails"
              }
            }
          }
        }
      }
    },
    "put": {
      "operationId": "customers.updateCustomer",
      "summary": "Update an customer",
      "tags": ["Customers"],
      "security": [{ "BearerAuth": [] }],
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/body/CustomerUpdateBody"
            }
          }
        }
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Id"
              }
            }
          }
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/errors/ValidationProblemDetails"
              }
            }
          }
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/errors/AuthProblemDetails"
              }
            }
          }
        },
        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/errors/NotFoundProblemDetails"
              }
            }
          }
        },
        "409": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/errors/ConflictProblemDetails"
              }
            }
          }
        }
      }
    },
    "delete": {
      "operationId": "customers.deleteCustomer",
      "summary": "Delete an customer",
      "tags": ["Customers"],
      "security": [{ "BearerAuth": [] }],
      "parameters": [{ "$ref": "#/components/parameters/Id" }],
      "responses": {
        "204": {
          "description": "Item deleted successfully"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/errors/ValidationProblemDetails"
              }
            }
          }
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/errors/AuthProblemDetails"
              }
            }
          }
        },
        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/errors/NotFoundProblemDetails"
              }
            }
          }
        }
      }
    }
  }
}
