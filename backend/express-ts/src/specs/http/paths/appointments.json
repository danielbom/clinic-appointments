  "/api/appointments": {
    "get": {
      "operationId": "appointments.listAppointments",
      "summary": "Get all appointments",
      "tags": ["Appointments"],
      "security": [{ "BearerAuth": [] }],
      "parameters": [
        { "$ref": "#/components/query/Page" },
        { "$ref": "#/components/query/PageSize" },
        { "$ref": "#/components/query/StartDate" },
        { "$ref": "#/components/query/EndDate" },
        { "$ref": "#/components/query/ServiceName" },
        { "$ref": "#/components/query/Specialist" },
        { "$ref": "#/components/query/Customer" },
        { "$ref": "#/components/query/Status" }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/Appointment" }
              }
            }
          }
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/errors/ValidationProblemDetails"
              }
            }
          }
