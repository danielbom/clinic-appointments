      "tags": ["Appointments"],
      "security": [{ "BearerAuth": [] }],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/body/AppointmentsCreateBody"
            }
          }
        }
      },
      "responses": {
