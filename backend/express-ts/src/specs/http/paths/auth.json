{
  "/api/auth/login": {
    "post": {
      "operationId": "auth.login",
      "summary": "Login",
      "tags": ["Auth"],
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/body/AuthLogin"
            }
          }
        }
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthResponse"
              }
            }
          }
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/errors/ValidationProblemDetails"
              }
            }
          }
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/errors/AuthProblemDetails"
              }
            }
          }
        }
      }
    }
  },
  "/api/auth/refresh": {
    "post": {
      "operationId": "auth.refresh",
      "summary": "Refresh",
      "tags": ["Auth"],
      "security": [{ "BearerAuth": [] }],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthResponse"
              }
            }
          }
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/errors/ValidationProblemDetails"
              }
            }
          }
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/errors/AuthProblemDetails"
              }
            }
          }
        },
        "500": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/errors/InternalProblemDetails"
              }
            }
          }
        }
      }
    }
  },
  "/api/auth/me": {
    "get": {
      "operationId": "auth.me",
      "summary": "Get user identity",
      "tags": ["Auth"],
      "security": [{ "BearerAuth": [] }],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthIdentity"
              }
            }
          }
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/errors/ValidationProblemDetails"
              }
            }
          }
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/errors/AuthProblemDetails"
              }
            }
          }
        }
      }
    }
  }
}
