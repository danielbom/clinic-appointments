{
  "name": "bun",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "server:start": "bun run src/server.ts",
    "server:dev": "bun run --watch src/server.ts",
    "lint": "bun biome check .",
    "format": "bun biome check . --fix",
    "generate": "bun run ./src/scripts/generate/index.ts",
    "check": "bun tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "latest",
    "@types/jsonwebtoken": "^9.0.10",
    "prettier": "^3.3.2",
    "prisma": "^7.8.0",
    "typescript": "6"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.8.0",
    "date-fns": "^4.4.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "uuid": "^14.0.0"
  }
}
